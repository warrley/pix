  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Volume PIX Transferido (R$)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBRL",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pix_amount_reais_total",
          "legendFormat": "Total (R$)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Transferências Concluídas vs Falhas",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (pix_transfers_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Chaves PIX Ativas por Tipo",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pix_active_keys_total",
          "legendFormat": "{{key_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Eventos de Segurança & Auditoria",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(pix_security_events_total)",
          "legendFormat": "Eventos de Auditoria",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Método RED — Taxa de Requisições HTTP por Rota (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, route, status_code) (rate(http_requests_total[1m]))",
          "legendFormat": "{{method}} {{route}} [{{status_code}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Método RED — Latência HTTP p95 por Rota (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Transferências PIX por Status e Código de Erro",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pix_transfers_total",
          "legendFormat": "{{status}} ({{error_code}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Auditoria de Segurança & Rate Limiting",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pix_security_events_total",
          "legendFormat": "audit: {{event}}",
          "refId": "A"
        },
        {
          "expr": "pix_auth_rate_limited_total",
          "legendFormat": "rate_limit: {{limiter}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Entregas de Notificações (Webhook / FCM / Logger)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pix_notifications_delivery_total",
          "legendFormat": "{{notifier}} - {{event_type}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Banco de Dados — Latência SQL p95 & Pool de Conexões",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(rails_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "SQL p95 {{operation}}",
          "refId": "A"
        },
        {
          "expr": "rails_db_connection_pool",
          "legendFormat": "pool {{state}}",
          "refId": "B"
        }
      ]
    }
  ],
