# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_development
DB_PORT_BINDING=5433:5432
DB_HOST=db
# Optional override for a managed PostgreSQL instance. Production must use
# sslmode=verify-full; keep the host aligned with the DB certificate.
DATABASE_URL=

# Rails Configuration
RAILS_ENV=development
SECRET_KEY_BASE=
BACKEND_PORT_BINDING=3000:3000
ALLOWED_HOSTS=pix.warley.xyz,localhost,127.0.0.1

# Optional application security settings. Keep production values in the VPS
# secret manager or its ignored .env file; never commit real secrets here.
CORS_ALLOWED_ORIGINS=
NOTIFICATIONS_WEBHOOK_URL=
NOTIFICATIONS_WEBHOOK_ALLOWED_HOSTS=
NOTIFICATIONS_WEBHOOK_SECRET=
RAILS_MASTER_KEY=
PGSSLROOTCERT=
