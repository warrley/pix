          "name": "1. Cadastro de Novo Usuário (Signup)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"name\": \"Novo Usuario Teste\",\n    \"email\": \"novo.usuario.{{$timestamp}}@example.com\",\n    \"doc_id\": \"{{dynamic_cpf}}\",\n    \"phone\": \"+5585999990099\",\n    \"password\": \"MinhaSenhaSegura@2026\",\n    \"password_confirmation\": \"MinhaSenhaSegura@2026\"\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/auth/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created ou 422 se ja existe', () => pm.expect([201, 422]).to.include(pm.response.code));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gerador dinâmico de CPF válido com dígitos verificadores",
                  "function gerarCPFValido() {",
                  "    let n = [];",
                  "    for (let i = 0; i < 9; i++) n.push(Math.floor(Math.random() * 10));",
                  "    ",
                  "    let d1 = n.reduce((total, num, i) => total + num * (10 - i), 0) % 11;",
                  "    d1 = d1 < 2 ? 0 : 11 - d1;",
                  "    n.push(d1);",
                  "    ",
                  "    let d2 = n.reduce((total, num, i) => total + num * (11 - i), 0) % 11;",
                  "    d2 = d2 < 2 ? 0 : 11 - d2;",
                  "    n.push(d2);",
                  "    ",
                  "    return n.join('');",
                  "}",
                  "",
                  "pm.variables.set('dynamic_cpf', gerarCPFValido());"
                ]
              }
            }
          ]
        },
